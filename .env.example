# Full Stack Environment Configuration
# Copy this to .env and update with your actual values

# PostgreSQL Database Configuration
POSTGRES_USER=teleprompter_user
POSTGRES_PASSWORD=teleprompter_pass
POSTGRES_DB=teleprompter
POSTGRES_PORT=5434  # Host port (internal port is 5432)

# Typesense (optional - set DISABLE_TYPESENSE=true to skip)
TYPESENSE_API_KEY=your_typesense_api_key
TYPESENSE_HOST=https://your-cluster.a1.typesense.net
DISABLE_TYPESENSE=true

# OpenAI Configuration (for Bible reference parsing from captions)
# Used as fallback if Ollama fails. Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini  # Fast, cost-effective model

# Ollama Configuration (AI Bible reference parsing)
# Model is pulled automatically on first run
OLLAMA_MODEL=gemma2:2b  # Options: gemma2:2b (fast), gemma3:4b (more accurate)

# Caption Processing
# Set to false for VPS deployment (use remote bible-parser-client instead)
ENABLE_CAPTION_PROCESSING=true

# Bible Parser API Key (for VPS deployment with remote parser)
# Generate with: openssl rand -hex 32
# Must match the API_KEY in bible-parser-client/.env
BIBLE_PARSER_API_KEY=your_secure_api_key_here

# Jgm Live Captions (for automatic Bible verse detection)
# Get API key from https://soniox.com
SONIOX_API_KEY=your_soniox_api_key_here
