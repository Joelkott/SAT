# Backend Environment Configuration
# This file is used when running backend directly (not via Docker Compose)

# Database Configuration (for local development)
DATABASE_URL=postgres://teleprompter_user:teleprompter_pass@localhost:5434/teleprompter?sslmode=disable

# Typesense Configuration (optional - can be disabled)
TYPESENSE_API_KEY=your_typesense_api_key_here
TYPESENSE_HOST=https://your-cluster.a1.typesense.net
DISABLE_TYPESENSE=true

# Server Configuration
PORT=8080

# Backup Configuration
BACKUP_DIR=./backups

# OpenAI Configuration (for Bible reference parsing from captions)
# Used as fallback if Ollama fails. Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama Configuration (local AI for Bible reference parsing)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Jgm Live Captions Integration (optional)
# Set this to enable automatic Bible reference detection from live captions
# JGM_CAPTIONS_URL=http://localhost:8081
# In Docker: JGM_CAPTIONS_URL=http://jgm-captions:8080

# Bible APIs (optional - bundled KJV/MOV/AMPC/ASV work without any key)
# api.bible key from https://scripture.api.bible
API_BIBLE_KEY=
API_BIBLE_BASE_URL=https://rest.api.bible/v1
# ESV API (Crossway) - https://api.esv.org/account/create-application/
ESV_API_KEY=

# Team account passwords - set real values in your local .env only (never commit them)
# guest = worship minus ProPresenter (songs, queue, Bible, display window)
AUTH_SECRET=
AUTH_ADMIN_PASSWORD=
AUTH_MEDIA_PASSWORD=
AUTH_WORSHIP_PASSWORD=
AUTH_GUEST_PASSWORD=
