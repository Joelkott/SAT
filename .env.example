# Copy to .env and fill in values: cp .env.example .env

# --- Database (used by docker-compose postgres + backend) ---
POSTGRES_USER=teleprompter_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=teleprompter
# Native (non-Docker) runs only; inside Docker the compose file builds the DSN.
DATABASE_URL=postgres://teleprompter_user:change_me_strong_password@localhost:5432/teleprompter?sslmode=disable

# --- Typesense search (https://cloud.typesense.org) ---
# Optional: without it, search falls back to the database.
TYPESENSE_API_KEY=
TYPESENSE_HOST=

# --- Bible (api.bible key from https://scripture.api.bible) ---
# Optional: local KJV + Malayalam OV work without it; the key adds ~270 more translations.
API_BIBLE_KEY=
API_BIBLE_BASE_URL=https://rest.api.bible/v1

# --- ESV API (Crossway) — https://api.esv.org/account/create-application/ ---
# Optional: without it the ESV translation is hidden; the bundled ones still work.
ESV_API_KEY=

# --- Frontend -> backend URL, baked into the frontend at BUILD time ---
# For multi-device use (tablets/laptops on the LAN), set to the server's LAN IP
# and rebuild the frontend: API_URL=http://192.168.x.x:8080/api
API_URL=http://localhost:8080/api

# --- Timezone (daily 2 AM backup fires in this zone) ---
TZ=UTC

# --- ProPresenter integration (optional) ---
PROPRESENTER_ENABLED=false
PROPRESENTER_HOST=
PROPRESENTER_PORT=62683
PROPRESENTER_PLAYLIST=Live Queue

# --- Server ---
PORT=8080
BACKUP_DIR=./backups
SKIP_TYPESENSE=false

# --- Live verse detection (phase 5) ---
# Caption SSE stream; empty = https://jgm-sermon-translate.duckdns.org/audience/stream, "off" disables
VERSE_DETECT_SSE_URL=
# TypeSafe Jev key for spoken/contextual references; empty = local parsing only. Never commit a real key.
TYPESAFE_API_KEY=

# --- Live captions / CORS ---
# Soniox key used by JGM Live Captions
SONIOX_API_KEY=
# Comma-separated CORS origins for prod (Vercel domain); empty = *
ALLOWED_ORIGINS=

# --- Team account passwords ---
# Set real values in your local .env only (never commit them).
# guest = worship minus ProPresenter (songs, queue, Bible, display window).
AUTH_SECRET=
AUTH_ADMIN_PASSWORD=
AUTH_MEDIA_PASSWORD=
AUTH_WORSHIP_PASSWORD=
AUTH_GUEST_PASSWORD=
