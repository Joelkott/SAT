# VPS Environment Configuration
# Copy this to .env on your VPS
#
# DEPLOYMENT SETUP:
# - Teleprompter Backend: VPS (via Caddy/HTTPS)
# - Teleprompter Frontend: Vercel
# - JGM Live Captions: VPS (Full stack - frontend + backend, via Caddy/HTTPS)
# - Bible Parser: Local machine with GPU

# PostgreSQL Configuration
POSTGRES_USER=teleprompter_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=teleprompter
POSTGRES_PORT=5434

# Backend Configuration
PORT=8080
BACKUP_DIR=/app/backups

# CORS Configuration for Teleprompter Backend
# Set to your Vercel domain(s), comma-separated
# Example: https://teleprompter.vercel.app,https://teleprompter-preview.vercel.app
ALLOWED_ORIGINS=https://your-teleprompter-app.vercel.app

# Disable local caption processing (remote parser handles it)
ENABLE_CAPTION_PROCESSING=false

# Bible Parser API Key (must match local bible-parser-client)
# Generate with: openssl rand -hex 32
BIBLE_PARSER_API_KEY=your_secure_api_key_here

# Typesense (optional - can be disabled)
DISABLE_TYPESENSE=true
TYPESENSE_API_KEY=
TYPESENSE_HOST=

# OpenAI (optional fallback if Ollama is unavailable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# JGM Live Captions Configuration
# JGM runs as complete stack on VPS (no changes to existing setup)
# Public URL: https://jgm-sermon-translate.duckdns.org
SONIOX_API_KEY=your_soniox_api_key
JGM_CAPTIONS_URL=http://jgm-captions:8080
