# Bible Parser Client Configuration
# This service runs on your local machine with GPU/CPU for Ollama

# JGM Live Captions SSE endpoint (on VPS)
# Example: https://jgm-sermon-translate.duckdns.org/api/audience-stream
JGM_SSE_URL=https://jgm-sermon-translate.duckdns.org/api/audience-stream

# Teleprompter API endpoint (on VPS)
# Example: https://api-teleprompter.your-domain.duckdns.org/api/bible-references
TELEPROMPTER_API_URL=https://your-teleprompter-duckdns-domain.duckdns.org/api/bible-references

# Local Ollama configuration
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# API Key for authentication with VPS
# Generate a secure random key: openssl rand -hex 32
# This must match BIBLE_PARSER_API_KEY in VPS .env
API_KEY=your-secret-api-key-here
